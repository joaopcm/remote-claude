#!/usr/bin/env bash
set -euo pipefail

CONFIG="${RC_CONFIG:-$HOME/.config/remote-claude/config}"
# shellcheck source=/dev/null
[ -f "$CONFIG" ] && source "$CONFIG"
VPS_HOST="${VPS_HOST:-vps}"
VPS_RC="${VPS_RC:-.local/bin/rc}"   # relative to remote $HOME

interactive() {
  if command -v mosh >/dev/null 2>&1 && [ "${RC_NO_MOSH:-0}" != 1 ]; then
    exec mosh "$VPS_HOST" -- "$VPS_RC" "$@"
  fi
  exec ssh -t "$VPS_HOST" "$VPS_RC" "$@"
}

cmd_ide() {
  local repo="${1:?usage: rc ide <repo> <branch>}" branch="${2:?usage: rc ide <repo> <branch>}"
  local path
  # shellcheck disable=SC2029  # client-side expansion intended: pass values to remote rc
  path="$(ssh "$VPS_HOST" "$VPS_RC" path "$repo" "$branch")"
  cursor --folder-uri "vscode-remote://ssh-remote+${VPS_HOST}${path}"
}

cmd_sync() {
  local items=(CLAUDE.md RTK.md rules skills hooks file-suggestion.sh plugins)
  local src
  ssh "$VPS_HOST" 'mkdir -p .claude'
  for item in "${items[@]}"; do
    src="$HOME/.claude/$item"
    [ -e "$src" ] || continue
    if [ -d "$src" ] || { [ -L "$src" ] && [ -d "$(readlink "$src")" ]; }; then
      echo "sync: $item/"
      rsync -aL --delete "$src/" "$VPS_HOST:.claude/$item/"
    else
      echo "sync: $item"
      rsync -aL "$src" "$VPS_HOST:.claude/$item"
    fi
  done
  echo "sync: settings.json (mac-only hooks stripped)"
  python3 - "$HOME/.claude/settings.json" <<'PY' | ssh "$VPS_HOST" 'cat > .claude/settings.json'
import json, sys

settings = json.load(open(sys.argv[1]))

MAC_ONLY = ("/Users/", "codedb")
def portable(hook):
    return not any(marker in hook.get("command", "") for marker in MAC_ONLY)

hooks = settings.get("hooks", {})
for event in list(hooks):
    entries = hooks[event]
    for entry in entries:
        entry["hooks"] = [h for h in entry.get("hooks", []) if portable(h)]
    hooks[event] = [e for e in entries if e["hooks"]]
    if not hooks[event]:
        del hooks[event]

for mac_key in ("preferredNotifChannel", "voiceEnabled"):
    settings.pop(mac_key, None)

print(json.dumps(settings, indent=2))
PY
  echo "sync: done"
}

cmd="${1:-attach}"
case "$cmd" in
  ide)        shift; cmd_ide "$@" ;;
  sync)       cmd_sync ;;
  ssh)        exec ssh -t "$VPS_HOST" ;;
  new|attach) interactive "$@" ;;
  *)          exec ssh -t "$VPS_HOST" "$VPS_RC" "$@" ;;
esac
